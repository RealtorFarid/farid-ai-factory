# Copy to .env and fill in. Never commit .env.
# cp .env.example .env

# ---- Application ---------------------------------------------------------
# One of: development | staging | production
PROPILOT_ENVIRONMENT=development
PROPILOT_DEBUG=true

# ---- HTTP server ---------------------------------------------------------
PROPILOT_HOST=127.0.0.1
PROPILOT_PORT=8000
# Comma-separated list, or "*" to allow all (rejected in production).
PROPILOT_CORS_ORIGINS=http://localhost:5173

# ---- Logging -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
PROPILOT_LOG_LEVEL=INFO
# json | console   (console is human-readable; json is for production)
PROPILOT_LOG_FORMAT=console

# ---- LLM -----------------------------------------------------------------
PROPILOT_OPENAI_API_KEY=sk-...
PROPILOT_DEFAULT_MODEL=openai:gpt-5
PROPILOT_AGENT_TIMEOUT_SECONDS=120
PROPILOT_MAX_PROMPT_CHARS=20000

# ---- Tracing (optional; leave blank to disable) --------------------------
PROPILOT_LANGFUSE_PUBLIC_KEY=
PROPILOT_LANGFUSE_SECRET_KEY=
PROPILOT_LANGFUSE_HOST=https://cloud.langfuse.com
